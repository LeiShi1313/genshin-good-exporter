{
  "manifest_version": 3,
  "name": "Genshin GOOD Exporter",
  "description": "Export equipped Genshin characters, weapons, and artifacts from HoYoLAB or 米游社 to GOOD v3.",
  "version": "0.3.5",
  "minimum_chrome_version": "111",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://act.hoyolab.com/*",
    "https://sg-act-public-api.hoyolab.com/*",
    "https://www.miyoushe.com/*",
    "https://webstatic.mihoyo.com/app/community-game-records/*",
    "https://api-takumi.mihoyo.com/*",
    "https://api-takumi-record.mihoyo.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_state": "enabled",
    "default_title": "Export Genshin builds to GOOD",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://act.hoyolab.com/app/community-game-records-sea/*",
        "https://www.miyoushe.com/ys/*",
        "https://webstatic.mihoyo.com/app/community-game-records/*"
      ],
      "js": [
        "src/page-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://act.hoyolab.com/app/community-game-records-sea/*",
        "https://www.miyoushe.com/ys/*",
        "https://webstatic.mihoyo.com/app/community-game-records/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
